<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Northfield.Fiscal.Desktop</AssemblyName>
    <RootNamespace>Northfield.Fiscal.Desktop</RootNamespace>
    <Version>0.2.0</Version>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\CompanyActions\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- O Visual Studio pode gerar/copiar arquivos MainForm*.resx auxiliares.
         Mantemos somente o recurso oficial do formulário para evitar dois
         .resources resolvendo para Northfield.Fiscal.Desktop.Forms.MainForm.resources. -->
    <EmbeddedResource Remove="**\MainForm*.resx" />
    <EmbeddedResource Include="Forms\MainForm.resx" Condition="Exists('Forms\MainForm.resx')">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\DocumentEditForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\DocumentEditForm.Designer.cs">
      <DependentUpon>DocumentEditForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\CompaniesListForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CompaniesListForm.Designer.cs">
      <DependentUpon>CompaniesListForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Controls\HomeWorkspaceControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Controls\HomeWorkspaceControl.Designer.cs">
      <DependentUpon>HomeWorkspaceControl.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
